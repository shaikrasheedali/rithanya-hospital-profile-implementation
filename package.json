{
  "name": "rithanya-full-stack",
  "version": "1.0.0",
  "private": true,
  "description": "Rithanya Hospital — monorepo (React 19.3 Vite client + Express + Prisma MySQL server). Backend serves built frontend.",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "postinstall": "npm --prefix server run prisma:generate",
    "install:all": "npm --prefix client install && npm --prefix server install",
    "dev": "npm --prefix server run dev",
    "build": "npm --prefix client run build && npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "build:server": "npm --prefix server run build",
    "prestart": "npm --prefix server run prisma:generate",
    "start": "node index.js",
    "prisma:generate": "npm --prefix server run prisma:generate",
    "db:migrate": "npm --prefix server run db:migrate",
    "db:seed": "npm --prefix server run db:seed",
    "db:setup": "npm --prefix server run db:setup",
    "test": "npm --prefix server run test",
    "test:client": "npm --prefix server run test:client",
    "test:e2e": "npm --prefix server run test:e2e",
    "typecheck": "npm --prefix client run typecheck && npm --prefix server run typecheck",
    "lint": "npm --prefix client run lint || true"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "mysql2": "^3.24.5"
  },
  "devDependencies": {
    "prisma": "^7.10.0"
  }
}
